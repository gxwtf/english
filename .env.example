# 数据库连接
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/gxwtf_english"

# SSO 配置
GXACCOUNT_URL="https://account.gxwtf.cn"

# iron-session 加密密码
# 必须至少32位字符，生产环境必须更换为强密码且不能泄露
# 建议使用：openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_COOKIE_PASSWORD="change-this-to-your-own-32-char-secret-password"

# API 认证密钥
# 用于作文积累查询 API 的认证
# 在服务器上，该字段的值与服务器密码相同
SECRET_API_KEY="change-this-to-your-secure-api-key-in-production"

# 词典文件路径（可选）
# 默认按运行时工作目录查找 src/dict/ecdict.csv（构建目录与运行目录不同也能正常工作）。
# 如果词典放在其它位置，可填写绝对路径：
# ECDICT_PATH="/absolute/path/to/ecdict.csv"

# AI 模型配置（LLM）
# 用于文本生成功能
LLM_CONFIGS='[
  {
    "name": "your-model-name",
    "model": "model-id",
    "apiKey": "your-ai-api-key-here",
    "apiBase": "https://your-api-base-url/v1"
  }
]'

# ========================================
# 拍照识词 OCR（Unlimited-OCR-2）
# 文字识别由常驻的 Unlimited-OCR-2（SGLang）完成，默认 http://127.0.0.1:8014。
# 本地 Python 微服务只做 OpenCV 透视/高亮检测与行切片，按需启动、闲置/超限后自动退出。
# 以下均为可选配置，通常无需设置。
# ========================================
# 文字识别后端地址（默认 http://127.0.0.1:8014）
# UNLIMITED_OCR_URL="http://127.0.0.1:8014"
# 显式设置后视为外部本地微服务，Web 端不再管理其进程
# OCR_SERVICE_URL="http://127.0.0.1:39821"
# 本地微服务端口
# OCR_SERVICE_PORT=39821
# 闲置多少毫秒后自动退出（默认 300000 = 5 分钟）
# OCR_SERVICE_IDLE_MS=300000
# 单进程处理多少请求后主动回收以释放内存（默认 30，0 表示禁用）
# OCR_SERVICE_MAX_REQUESTS=30
# 等待服务启动的最长时间（毫秒，默认 120000）
# OCR_SERVICE_START_TIMEOUT_MS=120000
# 服务源码目录（默认 <cwd>/paddleocr-service）
# OCR_SERVICE_DIR=
# 同时发往识别后端的并发请求数（默认 3）
# UNLIMITED_OCR_PARALLEL=3

# ========================================
# 生产环境部署注意事项
# ========================================
#
# 1. 必须更换以下密钥：
#    - SECRET_COOKIE_PASSWORD（至少32位强密码）
#    - SECRET_API_KEY（API认证密钥）
#    - DATABASE_URL中的数据库密码
#    - LLM_CONFIGS和LLM_IMAGE_CONFIGS中的apiKey
#
# 2. 安全建议：
#    - 使用HTTPS部署
#    - 定期更换API密钥
#    - 不要将.env文件上传到公开仓库
#    - 使用环境变量管理工具（如Vault、AWS Secrets Manager）
#
# 3. 密钥生成方法：
#    SECRET_COOKIE_PASSWORD: openssl rand -base64 32
#    SECRET_API_KEY: openssl rand -base64 32
#
# ========================================